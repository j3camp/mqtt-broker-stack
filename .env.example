# Mosquitto image version — update this to upgrade the broker
MOSQUITTO_VERSION=2.0.21

# External TLS listener binding
MQTT_TLS_PORT=8883
MQTT_TLS_BIND_ADDRESS=0.0.0.0

# Initial admin username created by init.sh
# Password is supplied interactively or via MQTT_INITIAL_PASSWORD env var
MQTT_INITIAL_USERNAME=admin

# Server hostname used for TLS SAN in development certificates
MQTT_SERVER_HOSTNAME=localhost
