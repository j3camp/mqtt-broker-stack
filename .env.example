# Immutable multi-architecture manifest for Eclipse Mosquitto 2.1.2-alpine.
MOSQUITTO_IMAGE=eclipse-mosquitto:2.1.2-alpine@sha256:6f8d8a947c506f8a2290ec65cd4bd2bc7cb4d43fb5f6271f861cb013e2ef9797

# External TLS and Secure WebSocket listeners.
MQTT_TLS_PORT=8883
MQTT_TLS_BIND_ADDRESS=0.0.0.0
MQTT_WSS_PORT=9001

# Mosquitto 2.1 automatic DynSec bootstrap creates this fixed admin username.
DYNSEC_ADMIN_USERNAME=admin
MQTT_CONTROL_HOSTNAME=mosquitto-control

# Server hostname used for the development certificate SAN.
MQTT_SERVER_HOSTNAME=localhost

# Administration console. Production deployments should use HTTPS, disable
# local auth after OIDC is configured, and never put client secrets in .env.
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=8088
ADMIN_PUBLIC_URL=http://localhost:8088
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
# Local Compose default. Set production together with HTTPS and secure cookies.
ADMIN_ENVIRONMENT=development
ADMIN_COOKIE_SECURE=false
ADMIN_LOCAL_AUTH_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_CERTIFICATE_WARNING_DAYS=30
ADMIN_BACKUP_MAX_AGE_HOURS=24

# OIDC is enabled only when discovery URL, client ID, and client secret are all
# supplied. Inject ADMIN_OIDC_CLIENT_SECRET_FILE through a deployment override.
ADMIN_OIDC_DISCOVERY_URL=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_ROLE_CLAIM=mqtt_admin_role
