# Optional ACL configuration.
# Copy this file or create /mosquitto/config/security/acl and run:
#   ./scripts/enable-acl.sh
# to activate ACL enforcement on the external listener.

# Administrative user — full read/write access to all topics
user admin
topic readwrite #

# Example device user
user device-001
topic read devices/device-001/config
topic write devices/device-001/telemetry/#

# Shared subscription example (allow all authenticated users)
# pattern readwrite $share/%s/#
