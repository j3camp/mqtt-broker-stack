# Optional Secure WebSocket listener.
# Rename this file to 40-websocket.conf to enable it.
# Ensure port 9001 is published in compose.yaml (or compose.console.yaml).
listener 9001
protocol websockets

allow_anonymous false
password_file /mosquitto/config/security/passwords

cafile /mosquitto/config/certs/ca.crt
certfile /mosquitto/config/certs/server.crt
keyfile /mosquitto/config/certs/server.key

tls_version tlsv1.2
